DISCORD_TOKEN=your_bot_token_here
VOICE_CHANNEL_ID=1234567890123456789

# Optional: custom path for birthday database (useful when running multiple bots)
# BIRTHDAY_DATA_PATH=data/birthdays.json

# ---------------------------------------------------------------------------
# Twitch chat → Discord mirror (optional)
# ---------------------------------------------------------------------------
# 1. Create a Twitch app or use https://twitchtokengenerator.com
#    Scopes needed: chat:read  (chat:write only if you later send to Twitch)
# 2. Token can be "oauth:xxxx" or just the access token
# 3. TWITCH_CHANNEL = your stream name without #
# 4. TWITCH_DISCORD_CHANNEL_ID = Discord text channel that receives the mirror
#
# TWITCH_TOKEN=oauth:your_twitch_access_token
# TWITCH_CHANNEL=your_channel_name
# TWITCH_DISCORD_CHANNEL_ID=1234567890123456789
# TWITCH_NICK=your_bot_or_account_login
# TWITCH_MIRROR_DELAY=0.35
