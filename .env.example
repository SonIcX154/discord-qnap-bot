# =============================================================================
# Required
# =============================================================================
DISCORD_TOKEN=your_bot_token_here
VOICE_CHANNEL_ID=1234567890123456789

# Container timezone is set in docker-compose.yml (TZ=Europe/Berlin).
# Affects /daily reset, birthday announces, and message-restore timestamps.

# Optional log level: DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# Bot developer / owner IDs – can always use admin-only commands
# (e.g. /voice-stayer) even without Manage Guild on that server.
# Single ID or comma-separated list:
# BOT_DEV_ID=406523291382186004
# BOT_DEV_IDS=406523291382186004,123456789012345678

# =============================================================================
# Birthdays (optional)
# =============================================================================
# BIRTHDAY_DATA_PATH=data/birthdays.json
# BIRTHDAY_ANNOUNCE_HOUR=0
# BIRTHDAY_ANNOUNCE_MINUTE=0

# =============================================================================
# Economy / minigames (optional)
# =============================================================================
# ECONOMY_DATA_PATH=data/economy.db
# ROULETTE_EMOTE=🎰

# =============================================================================
# Backup (optional overrides)
# =============================================================================
# BACKUP_DATA_PATH=data/backup.db
# BACKUP_ATTACHMENTS_PATH=data/backups/attachments
# Soft-deleted messages older than N days are hard-deleted automatically:
# BACKUP_SOFT_DELETE_RETENTION_DAYS=30
# How often the retention loop runs (hours):
# BACKUP_PURGE_INTERVAL_HOURS=24

# =============================================================================
# Twitch ↔ Discord mirror (optional)
# =============================================================================
# Twitch → Discord: webhook posts with Twitch display name + profile avatar.
# Discord → Twitch: human messages in the mirror channel go to chat as the bot
#   account, prefixed with [Discord] Name: …
# Deletes: bidirectional; message id map is persisted in SQLite.
#
# Required scopes on the token:
#   chat:read  chat:edit  user:write:chat  moderator:manage:chat_messages
# Bot account should be a mod in the Twitch channel.
#
# TWITCH_TOKEN=oauth:your_twitch_access_token
# TWITCH_CLIENT_ID=your_twitch_client_id
# TWITCH_CHANNEL=your_channel_name
# TWITCH_DISCORD_CHANNEL_ID=1234567890123456789
# TWITCH_NICK=bot_account_login
# TWITCH_MIRROR_DELAY=0.35
# TWITCH_DISCORD_TO_TWITCH=1
#   (set to 0 / false / off to disable Discord → Twitch)
# TWITCH_MIRROR_DB_PATH=data/twitch_mirror.db
# TWITCH_MIRROR_MSG_CACHE=3000
# Full /clear on Twitch only deletes Discord msgs mirrored in the last N seconds:
# TWITCH_CLEAR_WINDOW_SECONDS=600
#
# Convert your Twitch name in chat into a real Discord ping:
# DISCORD_OWNER_ID=your_discord_user_id
# TWITCH_OWNER_NAMES=yourlogin,YourDisplayName
#   (if TWITCH_OWNER_NAMES is omitted, TWITCH_CHANNEL is used)

# =============================================================================
# Twitch mod log → Discord (optional, EventSub WebSocket)
# =============================================================================
# Posts bans/timeouts, unbans, mod add/remove, shoutouts, incoming raids.
#
# Extra token scopes (in addition to mirror scopes):
#   moderator:read:banned_users
#   moderation:read
#   moderator:read:shoutouts
#
# TWITCH_MOD_LOG_CHANNEL_ID=1234567890123456789
