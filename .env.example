DISCORD_TOKEN=your_bot_token_here
VOICE_CHANNEL_ID=1234567890123456789

# Optional: custom path for birthday database (useful when running multiple bots)
# BIRTHDAY_DATA_PATH=data/birthdays.json

# ---------------------------------------------------------------------------
# Twitch ↔ Discord mirror (optional)
# ---------------------------------------------------------------------------
# Twitch → Discord: webhook posts with Twitch display name + profile avatar.
# Discord → Twitch: human messages in the mirror channel go to chat as the bot
#   account, prefixed with [Discord] Name: …
# Deletes: Discord delete of a forwarded msg → Twitch /delete (bot must be mod).
#
# TWITCH_TOKEN=oauth:your_twitch_access_token
# TWITCH_CLIENT_ID=your_twitch_client_id
# TWITCH_CHANNEL=your_channel_name
# TWITCH_DISCORD_CHANNEL_ID=1234567890123456789
# TWITCH_NICK=bot_account_login
# TWITCH_MIRROR_DELAY=0.35
# TWITCH_DISCORD_TO_TWITCH=1
#   (set to 0/false/off to disable Discord → Twitch)
#
# Convert @your_twitch_name in chat into a real Discord ping:
# DISCORD_OWNER_ID=your_discord_user_id
# TWITCH_OWNER_NAMES=yourlogin,YourDisplayName
#   (if TWITCH_OWNER_NAMES is omitted, TWITCH_CHANNEL is used)
